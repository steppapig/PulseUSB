// Resources embedded in PulseUSB.exe: icon, version details and manifest.
// Rebuild with:
//   llvm-rc /FO app.res app.rc
//   llvm-cvtres /MACHINE:X64 /OUT:rsrc_windows_amd64.syso app.res && rm app.res
// Keep the version numbers in step with Version in internal/gui/engine.go.
1 ICON "icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 0,24,2,0
PRODUCTVERSION 0,24,2,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PulseUSB open-source project"
            VALUE "FileDescription", "PulseUSB: use USB devices plugged into another computer"
            VALUE "FileVersion", "0.24.2"
            VALUE "InternalName", "PulseUSB"
            VALUE "LegalCopyright", "Open source; see the project repository"
            VALUE "OriginalFilename", "PulseUSB.exe"
            VALUE "ProductName", "PulseUSB"
            VALUE "ProductVersion", "0.24.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
