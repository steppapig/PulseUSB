<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for PulseUSB: sign every Windows program
  (.exe) in the artifact the build submits. The build submits twice per
  release: first the programs, then the setup program built around the
  signed PulseUSB.exe. Paste this into the project's artifact configuration
  in SignPath.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*.exe" max-matches="unbounded">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
